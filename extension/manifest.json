{
  "manifest_version": 3,
  "name": "TableFlow - Export HTML Tables to Excel",
  "version": "0.1.3",
  "description": "Export web tables to Excel (.xlsx), CSV, JSON and Markdown in one click. Local processing, Chinese support, no AI credits.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "action": {
    "default_title": "TableFlow",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "https://tableflow-license.vercel.app/*"
    ]
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
