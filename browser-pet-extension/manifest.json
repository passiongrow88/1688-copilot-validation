{
  "manifest_version": 3,
  "name": "My Browser Pet",
  "version": "0.1.0",
  "description": "A small pet companion that lives on the webpages you browse.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "My Browser Pet"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["pet.css"],
      "run_at": "document_idle"
    }
  ]
}
